# mPod backend settings. Every setting the backend reads is listed here.
# Lines starting with # are optional; remove the "# " to use them.
# Local development overrides (NODE_ENV, CORS, cookies) live in .env.development.local.
# Copy to backend/.env and fill in the <...> values. Never commit the real .env.

# ============================================================== Database & security
# MongoDB (must be a replica set, e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/m-pod?retryWrites=true&w=majority
# Signs login sessions and password-reset codes (at least 32 random characters)
JWT_SECRET=<at least 32 random characters: openssl rand -base64 48>

# ============================================================== AI
# Ollama is the primary model server for every AI task; OpenAI answers whenever
# Ollama doesn't respond (down, too slow, model missing, unusable answer).
AI_PROVIDER=dgx
AI_FALLBACK_PROVIDER=openai

# ---- Ollama
OLLAMA_URL=http://127.0.0.1:7002
# Model used for every task (per-task models below win over this one)
OLLAMA_MODEL=llama3.1:8b
# Optional per-task models
# DGX_SCORING_MODEL=gpt-oss:120b
# DGX_GENERATION_MODEL=gpt-oss:20b
# DGX_SUMMARY_MODEL=gpt-oss:20b
# DGX_CODING_MODEL=qwen3-coder:30b
# Context window (tokens). 4096 fits llama3.1:8b on an 8 GB Mac; use 8192 on the DGX Spark.
DGX_NUM_CTX=4096
# Requests sent to Ollama at once (keep <= OLLAMA_NUM_PARALLEL on the Ollama server)
DGX_MAX_CONCURRENCY=4
# Load the model into memory when the backend starts
DGX_PRELOAD=false
# Keep models loaded (-1 = forever)
# DGX_KEEP_ALIVE=-1
# Reasoning models: auto | true | false | low | medium | high, and extra tokens for thinking
# DGX_THINK=auto
# DGX_REASONING_TOKENS=2048
# After this long without an answer Ollama counts as down and OpenAI takes over (ms)
# DGX_TIMEOUT_MS=180000
# DGX_INTERACTIVE_TIMEOUT_MS=60000
# Ollama on another machine (DGX Spark gateway): address, key, protocol (ollama | openai)
# DGX_BASE_URL=https://ai.your-domain
# DGX_API_KEY=
# DGX_PROTOCOL=ollama
# DGX_ALLOW_INSECURE=false
# Camera model on the DGX Spark (empty = runs in the student's browser)
# DGX_VISION_URL=https://ai.your-domain/vision
# DGX_VISION_API_KEY=
# DGX_VISION_INTERVAL_MS=1000

# ---- OpenAI (backup)
OPENAI_API_KEY=<openai api key>
OPENAI_SCORING_MODEL=gpt-5.5
OPENAI_GENERATION_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.4
OPENAI_CODING_MODEL=gpt-5.5
# GPT-5-family models: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=

# ============================================================== Email
# Gmail address + app password, for password-reset codes and schedule emails
EMAIL_USER=<sender@gmail.com>
EMAIL_PASS=<gmail app password>

# ============================================================== Server
PORT=8002
# production on the server (enables secure cookies, hides error details)
# NODE_ENV=production
# 127.0.0.1 when nginx runs on the same machine
# HOST=127.0.0.1
# Website addresses allowed to call the API (comma separated)
# CORS_ORIGINS=https://your-domain
# COOKIE_SECURE=true
# TRUST_PROXY=loopback
# Public address of this backend (technology icon links)
# PUBLIC_BACKEND_URL=https://your-domain/backend/

# ============================================================== Interviews
# Minutes after the start time a student may still start
INTERVIEW_START_GRACE_MINUTES=5
# Minutes before the start time the Attempt button appears
INTERVIEW_EARLY_START_MINUTES=1
# Minutes after the deadline an unsubmitted attempt is submitted automatically
INTERVIEW_SUBMIT_GRACE_MINUTES=10
# Login length: staff and students (hours), kiosks (days)
SESSION_HOURS=24
KIOSK_SESSION_DAYS=365
# Interviews scored at the same time x AI calls per interview
EVALUATION_CONCURRENCY=3
LLM_PARALLEL_CALLS=4
